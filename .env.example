# Copy to .env for local development. Set the production values in Vercel.

RESEND_API_KEY=

# Local: Resend only allows this sandbox sender until a domain is verified.
# Production: a verified domain address, e.g. info@safarisoul.africa
RESEND_FROM_EMAIL=onboarding@resend.dev

# Comma-separated staff notification recipients.
# With the sandbox sender, Resend only delivers to the email on the Resend account.
RESEND_STAFF_EMAILS=you@example.com
